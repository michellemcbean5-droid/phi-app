# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#     https://docs.fastlane.tools/actions
#

default_platform(:android)

# ───────────────────────────────────────────────────────────────
# Android Lanes
# ───────────────────────────────────────────────────────────────

platform :android do
  desc "Run unit tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build a debug APK"
  lane :debug do
    gradle(task: "assembleDebug")
  end

  desc "Build a release AAB (Play Store bundle)"
  lane :build do
    gradle(task: "bundleRelease")
  end

  desc "Deploy to Google Play (Internal Testing track)"
  lane :deploy_internal do
    gradle(task: "bundleRelease")
    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      aab: "./android/app/build/outputs/bundle/release/app-release.aab"
    )
  end

  desc "Promote Internal → Alpha"
  lane :promote_alpha do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha"
    )
  end

  desc "Promote Alpha → Production"
  lane :promote_production do
    upload_to_play_store(
      track: "alpha",
      track_promote_to: "production"
    )
  end

  desc "Capture screenshots automatically"
  lane :screenshots do
    capture_android_screenshots(
      app_package_name: "com.princehaulintelligence.app",
      locales: ["en-US"],
      clear_previous_screenshots: true,
      use_adb_root: true
    )
  end
end

# ───────────────────────────────────────────────────────────────
# iOS Lanes
# ───────────────────────────────────────────────────────────────

platform :ios do
  desc "Run tests"
  lane :test do
    scan(scheme: "PHIApp")
  end

  desc "Build and archive for App Store"
  lane :build do
    build_app(
      scheme: "PHIApp",
      workspace: "ios/PHIApp.xcworkspace",
      export_method: "app-store"
    )
  end

  desc "Upload to App Store Connect (TestFlight)"
  lane :beta do
    increment_build_number(xcodeproj: "ios/PHIApp.xcodeproj")
    build_app(
      scheme: "PHIApp",
      workspace: "ios/PHIApp.xcworkspace",
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      notify_external_testers: false
    )
  end

  desc "Deploy to App Store (production review)"
  lane :deploy do
    build_app(
      scheme: "PHIApp",
      workspace: "ios/PHIApp.xcworkspace",
      export_method: "app-store"
    )
    upload_to_app_store(
      force: true,
      skip_screenshots: false,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Capture iOS screenshots"
  lane :screenshots do
    capture_ios_screenshots(
      scheme: "PHIApp",
      languages: ["en-US"],
      clear_previous_screenshots: true
    )
    frame_screenshots(white: true)
  end
end
